# ============================================================
# Smart Passport Photo Studio — environment template
# ------------------------------------------------------------
# Copy this file to server/.env and fill in your values:
#   cp .env.example server/.env
# The server reads env from ITS OWN directory (server/.env),
# so always start it from server/ (npm run dev / npm start).
# NEVER commit a real .env file with secrets.
# ============================================================

# Port the API server listens on.
PORT=4000

# Background-removal provider: "removebg" | "rembg-local" | "none"
# (default: rembg-local — free, unlimited, runs on your own PC)
#   removebg    -> remove.bg cloud API (needs REMOVEBG_API_KEY below).
#                 See AI_API_SETUP.md for signup + pricing.
#   rembg-local -> local Python `rembg` via the bundled server/rembg_stdin.py
#                 adapter (stable rembg Python API; works with rembg 1.x/2.x).
#                 Needs `pip install "rembg[cpu,cli]" onnxruntime`; first run
#                 downloads the model (~176MB for u2net).
#   none        -> background removal disabled; photo-processing jobs
#                 fail with a clear "Background removal not configured" error.
# (If BG_PROVIDER is left unset, the server defaults to rembg-local.)
BG_PROVIDER=rembg-local

# Model used by BG_PROVIDER=rembg-local. Any model name rembg supports
# (u2net, u2net_human_seg, isnet-general-use, ...). Default u2net.
REMBG_MODEL=u2net

# API key for remove.bg. Read ONLY from process.env on the server —
# never sent to the client, never logged. Leave empty unless
# BG_PROVIDER=removebg.
REMOVEBG_API_KEY=

# Max size of a single uploaded file, in megabytes.
MAX_FILE_MB=15

# Max number of files accepted in one upload batch.
MAX_FILES=100

# Housekeeping: stored uploads, processed images and job records older
# than this many hours are deleted by the background cleanup task.
CLEANUP_HOURS=24
