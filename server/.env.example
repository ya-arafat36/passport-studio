# Smart Passport Photo Studio — server env
# Copy to .env and fill in. NEVER commit real keys.

# Port the API listens on
PORT=4000

# Background removal provider: "removebg" | "rembg-local" | "none"
# (default: rembg-local — free, unlimited, runs on your own PC)
BG_PROVIDER=rembg-local

# rembg model used by BG_PROVIDER=rembg-local (via bundled rembg_stdin.py).
# Any model name rembg supports, e.g. u2net, u2net_human_seg, isnet-general-use.
REMBG_MODEL=u2net

# API key for remove.bg (only read from process.env; never log it)
REMOVEBG_API_KEY=

# Max upload size per file (MB) and max files per upload batch
MAX_FILE_MB=15
MAX_FILES=100

# Cleanup: delete stored files/records older than this many hours
CLEANUP_HOURS=24
